<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>{{ title or "WhatsApp web" }} - 官方指南</title>
    <style>
        :root { --primary: #075E54; --accent: #25D366; }
        body { font-family: sans-serif; line-height: 1.8; color: #333; margin: 0; background: #f4f7f6; }
        header { background: var(--primary); color: #fff; padding: 40px; text-align: center; border-bottom: 4px solid var(--accent); }
        .container { max-width: 1000px; margin: 20px auto; background: #fff; padding: 30px; border-radius: 8px; }
        .post-list { border: 1px solid #eee; padding: 15px; background: #fafafa; }
        .friend-links { margin-top: 30px; text-align: center; font-size: 14px; border-top: 1px solid #eee; padding-top: 20px; }
        .friend-links a { margin: 0 10px; color: var(--primary); text-decoration: none; }
    </style>
    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
    <script>LA.init({id:"3K7l95Zodr0uFrIN",ck:"3K7l95Zodr0uFrIN"})</script>
</head>
<body>
    <header><h1>WhatsApp web</h1></header>
    <div class="container">
        {% block content %}{% endblock %}

        <div class="post-list">
            <h3>📂 最新后台更新</h3>
            {% for post in collections.posts %}
            <div class="item">
                <h2 style="font-size:18px;"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            </div>
            {% endfor %}
        </div>

        <div class="post-pagination" style="display:flex; justify-content:space-between; margin-top:30px;">
            {% if prevPost %}<a href="{{ prevPost.url }}">← 上一篇：{{ prevPost.data.title }}</a>{% endif %}
            {% if nextPost %}<a href="{{ nextPost.url }}">下一篇：{{ nextPost.data.title }} →</a>{% endif %}
        </div>

        <div class="friend-links">
            <strong>站群互链：</strong>
            <a href="http://qhsdk.com">qhsdk.com</a> | <a href="http://qvfdc.com">qvfdc.com</a> | <a href="http://rcqry.com">rcqry.com</a> | <a href="http://rdqjm.com">rdqjm.com</a>
        </div>
    </div>
</body>
</html>