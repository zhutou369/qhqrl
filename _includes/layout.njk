<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - WhatsApp官方通讯中心</title>
    <meta name="keywords" content="whatsapp网页版登录, whatsapp官方, whatsapp网页版登入, whatsapp在线登陆, whatapp web">
    <meta name="description" content="{{ description or "提供专业的whatsapp网页版登录及官方安全通讯指南。" }}">
    
    <style>
        :root { --main-color: #075E54; --accent-color: #25D366; --bg: #f4f7f6; }
        body { font-family: "PingFang SC", "Microsoft YaHei", sans-serif; line-height: 1.8; color: #333; margin: 0; background: var(--bg); display: flex; flex-direction: column; min-height: 100vh; }
        
        header { background: var(--main-color); color: white; padding: 30px 0; text-align: center; border-bottom: 4px solid var(--accent-color); }
        header a { color: white; text-decoration: none; font-size: 22px; font-weight: bold; }

        /* 文章容器：强制对齐 */
        .article-wrapper { max-width: 1000px; margin: 30px auto; background: #fff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); flex: 1; }
        
        .article-header { border-bottom: 1px solid #eee; margin-bottom: 30px; padding-bottom: 15px; }
        .article-header h1 { color: var(--main-color); margin: 0; font-size: 28px; }
        
        .article-body { font-size: 16px; color: #444; text-align: justify; }
        .article-body h2 { color: var(--main-color); margin-top: 35px; border-left: 5px solid var(--accent-color); padding-left: 15px; }
        .article-body p { margin-bottom: 20px; text-indent: 2em; }

        /* 翻页导航：完美左右对齐 */
        .post-nav { 
            display: flex; 
            justify-content: space-between; 
            align-items: stretch;
            margin-top: 60px; 
            padding-top: 25px; 
            border-top: 1px solid #eee; 
            gap: 20px;
        }
        .nav-item { flex: 1; display: flex; flex-direction: column; }
        .nav-item.next { text-align: right; align-items: flex-end; }
        
        .nav-label { font-size: 12px; color: #999; margin-bottom: 8px; text-transform: uppercase; }
        .nav-link { 
            text-decoration: none; 
            color: var(--main-color); 
            font-weight: bold; 
            font-size: 15px;
            max-width: 300px;
            transition: color 0.3s;
        }
        .nav-link:hover { color: var(--accent-color); }

        /* 站群互链 */
        .site-links { margin-top: 40px; padding: 20px; background: #fafafa; border-radius: 5px; text-align: center; }
        .site-links a { margin: 0 12px; color: #666; text-decoration: none; font-size: 14px; }
        .site-links a:hover { color: var(--main-color); }

        footer { text-align: center; padding: 40px; color: #bbb; font-size: 13px; }
    </style>

    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
    <script>LA.init({id:"3K7l95Zodr0uFrIN",ck:"3K7l95Zodr0uFrIN"})</script>
</head>
<body>

<header>
    <a href="/">WhatsApp官方通讯中心</a>
</header>

<div class="article-wrapper">
    <article>
        <div class="article-header">
            <h1>{{ title }}</h1>
        </div>

        <div class="article-body">
            {{ content | safe }}
        </div>
    </article>

    <nav class="post-nav">
        <div class="nav-item prev">
            {% if prevPost %}
                <span class="nav-label">上一篇教程</span>
                <a href="{{ prevPost.url }}" class="nav-link">← {{ prevPost.data.title }}</a>
            {% else %}
                <span class="nav-label">已经是第一篇</span>
                <a href="/" class="nav-link">← 返回首页入口</a>
            {% endif %}
        </div>
        
        <div class="nav-item next">
            {% if nextPost %}
                <span class="nav-label">下一篇动态</span>
                <a href="{{ nextPost.url }}" class="nav-link">{{ nextPost.data.title }} →</a>
            {% endif %}
        </div>
    </nav>

    <div class="site-links">
        <strong>站群互链：</strong>
        <a href="http://qhqrl.com">qhqrl.com</a>
        <a href="http://qhsdk.com">qhsdk.com</a>
        <a href="http://qvfdc.com">qvfdc.com</a>
        <a href="http://rcqry.com">rcqry.com</a>
        <a href="http://rdqjm.com">rdqjm.com</a>
    </div>
</div>

<footer>
    <p>&copy; 2026 qhqrl.com - 专业通讯技术支持</p>
</footer>

</body>
</html>